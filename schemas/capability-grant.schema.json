{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADGL CapabilityGrant",
  "type": "object",
  "required": [
    "id",
    "actions",
    "case_id"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "case_id": {
      "type": "string"
    },
    "max_calls": {
      "type": "integer",
      "minimum": 0
    },
    "max_value": {
      "type": "number",
      "minimum": 0
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}